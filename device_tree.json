{
  "$schema": "../JaszczurHAL/config/hardware/device_tree.schema.json",
  "schemaVersion": 1,
  "nodes": {
    "egtPreDpf": { "compatible": "jaszczurhal,i2c-device" },
    "egtMidDpf": { "compatible": "jaszczurhal,i2c-device" },
    "modem": { "compatible": "jaszczurhal,uart-device" },
    "modemPower": { "compatible": "jaszczurhal,gpio-output" },
    "dpfPressure": { "compatible": "jaszczurhal,adc-input" },
    "pumpPulse": {
      "compatible": "jaszczurhal,gpio-input",
      "properties": { "activeLow": true, "pull": "up" }
    },
    "glowPlug": {
      "compatible": "jaszczurhal,gpio-input",
      "properties": { "activeLow": true, "pull": "up" }
    },
    "statusRgb": {
      "compatible": "jaszczurhal,addressable-led",
      "properties": { "pixelOrder": "GRB", "count": 1 }
    }
  },
  "assemblies": {
    "rp2040-zero": {
      "target": "rp2040",
      "board": "rp2040-zero",
      "clock": { "tree": "default" },
      "statusLed": { "node": "board.statusLed", "pixelOrder": "GRB" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 100000,
          "pins": { "sda": 0, "scl": 1 }
        },
        "modemUart": {
          "kind": "uart",
          "index": 1,
          "baudRate": 115200,
          "frame": { "dataBits": 8, "parity": "none", "stopBits": 1 },
          "pins": { "tx": 4, "rx": 5 }
        }
      },
      "nodes": {
        "egtPreDpf": { "present": true, "bus": "i2c", "address": 96 },
        "egtMidDpf": { "present": true, "bus": "i2c", "address": 103 },
        "modem": { "present": true, "bus": "modemUart" },
        "modemPower": { "present": true, "pins": { "out": 6 } },
        "dpfPressure": { "present": true, "pins": { "in": 26 } },
        "pumpPulse": { "present": true, "pins": { "in": 2 } },
        "glowPlug": { "present": true, "pins": { "in": 3 } },
        "statusRgb": { "present": false }
      }
    },
    "nucleo": {
      "target": "stm32g474",
      "board": "nucleo-g474re",
      "clock": { "tree": "default" },
      "statusLed": { "node": "statusRgb" },
      "buses": {
        "i2c": {
          "kind": "i2c",
          "index": 0,
          "frequencyHz": 100000,
          "pins": { "sda": "PB9", "scl": "PB8" }
        },
        "modemUart": {
          "kind": "uart",
          "index": 0,
          "baudRate": 115200,
          "frame": { "dataBits": 8, "parity": "none", "stopBits": 1 },
          "pins": { "tx": "PA9", "rx": "PA10" }
        }
      },
      "nodes": {
        "egtPreDpf": { "present": true, "bus": "i2c", "address": 96 },
        "egtMidDpf": { "present": true, "bus": "i2c", "address": 103 },
        "modem": { "present": true, "bus": "modemUart" },
        "modemPower": { "present": true, "pins": { "out": "PB5" } },
        "dpfPressure": { "present": true, "pins": { "in": "PA0" } },
        "pumpPulse": { "present": true, "pins": { "in": "PB4" } },
        "glowPlug": { "present": true, "pins": { "in": "PB10" } },
        "statusRgb": { "present": true, "pins": { "data": "PA8" } }
      }
    }
  }
}
